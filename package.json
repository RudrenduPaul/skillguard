{
  "name": "skillguard-cli",
  "version": "0.2.4",
  "description": "Security scanner for third-party AI agent-skill files: SKILL.md manifests, hooks, and bundled scripts.",
  "keywords": [
    "security",
    "static-analysis",
    "cli",
    "agent-skills",
    "sarif",
    "ci",
    "mcp",
    "prompt-injection",
    "supply-chain",
    "supply-chain-security",
    "sast",
    "llm-security",
    "ai-agents",
    "github-action"
  ],
  "license": "Apache-2.0",
  "author": "Rudrendu Paul",
  "contributors": [
    "Sourav Nandy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RudrenduPaul/skillguard.git"
  },
  "homepage": "https://github.com/RudrenduPaul/skillguard#readme",
  "bugs": {
    "url": "https://github.com/RudrenduPaul/skillguard/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "skillguard-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "rulepacks",
    "examples",
    "action.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "commander": "14.0.3",
    "minimatch": "10.2.6",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
